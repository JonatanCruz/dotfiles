{
  "mcpServers": {
    "playwright-chrome": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.83",
        "--browser=chrome"
      ]
    },
    "playwright-firefox": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.83",
        "--browser=firefox"
      ]
    },
    "playwright-safari": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.83",
        "--browser=webkit"
      ]
    },
    "engram": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": ["${HOME}/.claude/engram-mcp.sh"]
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp"
    },
    "magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@0.2.3"
      ],
      "env": {
        "API_KEY": "${MAGIC_API_KEY}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2.0.0"
      ]
    },
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.2.22"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
  }
}
