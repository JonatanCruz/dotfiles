# ============================================================================
# CONFIGURACIÓN DE GIT
# ============================================================================
# Usa git-delta como pager si está instalado (si no, cae a less)

# ----------------------------------------------------------------------------
# IDENTIDAD
# ----------------------------------------------------------------------------
# [user] no se versiona: el repo es público y quien hiciera `stow git` firmaría
# sus commits con una identidad ajena. Crea ~/.gitconfig-local con tus datos:
#
#     [user]
#         name  = Tu Nombre
#         email = tu@email.com
#
# Para separar identidades por directorio, usa [includeIf "gitdir:~/trabajo/"]
# (la barra final importa: cubre el subárbol).

[include]
	path = ~/.gitconfig-local

[init]
	defaultBranch = main

[core]
	editor = nvim
	# delta si está instalado; si no, less. Un `pager = delta` a secas rompe
	# `git log`/`git diff` en cualquier máquina sin delta (servidor recién
	# instalado, contenedor...). Git ejecuta el pager con sh y exporta
	# LESS=FRX si no está definido, así que el fallback se comporta igual que
	# el pager por defecto.
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less; fi"
	# Sin core.filemode global: git lo autodetecta en cada `init`/`clone`, y
	# forzarlo a false oculta los `chmod +x` de los scripts en todos los repos.
	# Sin core.compression = 9: cuesta CPU en cada commit/gc/push para ahorrar
	# muy poco frente al nivel por defecto de zlib.
	excludesfile = ~/.gitignore_global

[interactive]
	# Mismo criterio: sin delta, `git add -p` falla con "mismatched output".
	# `cat` deja pasar el diff tal cual (git ya lo colorea).
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"

# ============================================================================
# DELTA (Diff Viewer Mejorado)
# ============================================================================
# Los colores viven en .gitconfig-colors, GENERADO desde theme/palette.sh.
# Para cambiarlos: edita la paleta y corre `theme/apply.sh`. No edites el
# archivo incluido a mano.

[include]
	path = ~/.gitconfig-colors

# ============================================================================
# MERGE Y DIFF
# ============================================================================

[merge]
	tool = nvimdiff
	# zdiff3 (git ≥ 2.35): como diff3, pero saca del bloque en conflicto las
	# líneas comunes del principio y del final.
	conflictstyle = zdiff3

[mergetool]
	prompt = false
	keepBackup = false

[mergetool "nvimdiff"]
	cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
	tool = nvimdiff
	colorMoved = default
	# histogram da diffs mucho más claros en código movido/reordenado,
	# justo donde delta side-by-side ayuda menos.
	algorithm = histogram
	mnemonicPrefix = true

[difftool]
	prompt = false

[difftool "nvimdiff"]
	cmd = nvim -d $LOCAL $REMOTE

# ============================================================================
# PULL Y PUSH
# ============================================================================

[pull]
	rebase = false
	ff = only

[push]
	default = current
	followTags = true
	autoSetupRemote = true

[fetch]
	prune = true
	pruneTags = true

# ============================================================================
# ALIASES ÚTILES
# ============================================================================

[alias]
	# Status
	s = status -sb
	st = status

	# Add
	a = add
	aa = add --all
	ap = add --patch

	# Commit
	c = commit
	cm = commit -m
	ca = commit --amend
	can = commit --amend --no-edit

	# Branch
	b = branch
	ba = branch -a
	bd = branch -d
	bD = branch -D

	# Checkout
	co = checkout
	cob = checkout -b

	# Log
	l = log --oneline --graph --decorate
	lg = log --oneline --graph --decorate --all
	lgg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	last = log -1 HEAD --stat

	# Diff
	d = diff
	ds = diff --staged
	dw = diff --word-diff

	# Stash
	sl = stash list
	# `stash save` está obsoleto; `push` admite pathspecs y -m
	ss = stash push
	sp = stash pop
	sa = stash apply

	# Reset
	unstage = reset HEAD --
	undo = reset --soft HEAD^

	# Remote
	r = remote -v

	# Push/Pull
	p = push
	pl = pull
	pf = push --force-with-lease

	# Otros
	tags = tag -l
	branches = branch -a
	remotes = remote -v

	# Limpieza
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"

	# Visualización mejorada
	tree = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

	# Contribuidores
	contributors = shortlog -sn

# ============================================================================
# COLORES
# ============================================================================

[color]
	ui = auto
	branch = auto
	diff = auto
	status = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = green
	changed = yellow
	untracked = red

# ============================================================================
# CREDENCIALES (HTTPS)
# ============================================================================
# Para github.com, gh hace de helper: funciona igual en macOS y Linux (antes
# era `osxkeychain`, que no existe en Linux). Requiere `gh auth login`.
# El `helper =` vacío vacía la lista para no encadenar helpers heredados de
# la config del sistema. Para otros hosts, define el helper que quieras en
# ~/.gitconfig-local (p. ej. `osxkeychain` en la Mac).

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# ============================================================================
# OPTIMIZACIONES
# ============================================================================

[rerere]
	enabled = true
	# Sin autoupdate, rerere recuerda la resolución pero te obliga a
	# re-confirmarla a mano — media función.
	autoupdate = true

[commit]
	# Incluye el diff como comentario en la plantilla del mensaje
	verbose = true

[branch]
	# Ramas ordenadas por commit más reciente, no alfabéticamente
	sort = -committerdate

[tag]
	# Ordena versiones como esperarías (v1.9 antes de v1.10)
	sort = -version:refname

[column]
	ui = auto

[help]
	# Pregunta antes de ejecutar el comando corregido (con 1 lo ejecutaba a
	# la décima de segundo, sin margen para cancelar).
	autocorrect = prompt

[protocol]
	version = 2
